{
  "name": "stardust-web-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "build": "vue-tsc --noEmit && vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "type-check": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.test.json",
    "check": "pnpm run lint && pnpm run type-check",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:unit:watch": "vitest watch --config vitest.config.unit.ts",
    "test:coverage": "vitest run --config vitest.config.unit.ts --coverage",
    "ct:server": "vite --config ct/vite.config.ts --port 5190",
    "test:ct": "playwright test --config playwright-ct.config.ts",
    "test:ct:update": "playwright test --config playwright-ct.config.ts --update-snapshots",
    "test:ct:headed": "playwright test --config playwright-ct.config.ts --project=chromium-ct --headed",
    "test:ct:dev": "playwright test --config playwright-ct.config.ts --project=chromium-ct --headed --update-snapshots",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report e2e-report"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@newlifex/cube-vue": "workspace:*",
    "dayjs": "^1.11.0",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.55.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.9",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitejs/plugin-vue-jsx": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.5.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jiti": "^2.4.2",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  }
}
