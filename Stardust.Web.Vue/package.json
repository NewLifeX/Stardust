{
  "name": "stardust-web-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "build": "vue-tsc --noEmit && vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "type-check": "vue-tsc --noEmit",
    "check": "pnpm run lint && pnpm run type-check",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report e2e-report"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@newlifex/cube-vue": "workspace:*",
    "dayjs": "^1.11.0",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitejs/plugin-vue-jsx": "^4.1.0",
    "autoprefixer": "^10.5.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jiti": "^2.4.2",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.4.3",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  }
}
