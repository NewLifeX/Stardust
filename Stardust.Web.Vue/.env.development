VITE_APP_ENV=development
VITE_APP_TITLE=星枢 · 无界星图 - 开发环境
# 留空：前端走同源相对路径，由 Vite 代理转发到后端（见 vite.config.ts 的 VITE_PROXY_TARGET）
# 默认对接解耦的纯 API 后端 Stardust.WebApi（端口 6681）；如需连 Razor 管理界面后端可改为 http://localhost:6680
# VITE_APP_BASE_API=/api
VITE_APP_BASE_API=http://localhost:6681
VITE_PROXY_TARGET=http://localhost:6681
