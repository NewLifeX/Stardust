<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>StarServer</AssemblyName>
    <AssemblyTitle>Stardust service platform</AssemblyTitle>
    <Description>Backend core of the Stardust distributed service platform. Provides APIs for node management, application center, configuration center, registry and service discovery, monitoring and alerting, release center, gateway and MCP, together with metric aggregation, statistics and scheduled tasks; scales horizontally.</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 NewLife</Copyright>
    <VersionPrefix>3.7</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin\Server</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>1701;1702;NU5104;NETSDK1138;CS7035;CS9107;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8622;CS8625;CS8764;CS8765</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0'">
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <!--<PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>false</StackTraceSupport>-->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NewLife.IP" Version="2.6.2026.1024" />
    <PackageReference Include="NewLife.Redis" Version="7.0.2026.1024" />
    <PackageReference Include="NewLife.Remoting.Extensions" Version="4.0.2026.1024" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stardust.Data\Stardust.Data.csproj" />
    <ProjectReference Include="..\Stardust.Extensions\Stardust.Extensions.csproj" />
    <ProjectReference Include="..\Stardust\Stardust.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Locales 目录由 NewLife.Core 源生成器编译期解析；本项目未直接引用 Core 包，显式挂载输入 -->
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\Locales\*.yml" />
  </ItemGroup>

  <ItemGroup>
    <!-- 安装引导页与安装脚本模板。虚拟路径固定，运行时按名称读取 -->
    <EmbeddedResource Include="Resources\install.html" LogicalName="install.html" />
    <EmbeddedResource Include="Resources\install-linux.tpl" LogicalName="install-linux.tpl" />
    <EmbeddedResource Include="Resources\install-windows.tpl" LogicalName="install-windows.tpl" />
    <EmbeddedResource Include="Resources\leaf.png" LogicalName="leaf.png" />
  </ItemGroup>

</Project>
