<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net45;net461;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyTitle>Stardust agent</AssemblyTitle>
    <Description>Node guardian agent for Stardust. Deployed on every application server or edge node, providing process supervision, remote deployment, performance metrics collection (CPU/memory/disk/network/GPU), log and metric reporting, and supporting Windows services, Linux systemd, and IoT edge environments.</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 NewLife</Copyright>
    <VersionPrefix>3.7</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin\Agent</OutputPath>
    <!--<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>-->
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
    <IsPackable>False</IsPackable>
    <NoWarn>1701;1702;NU5104;NETSDK1138;CS7035;CS8600;CS8602;CS8603;CS8604;CS8618;CS8619;CS8622;CS8625</NoWarn>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0'">
    <!--<ServerGarbageCollection>true</ServerGarbageCollection>-->
    <!--<GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>-->
    <!--<PublishAot>true</PublishAot>-->
    <!--<OptimizationPreference>Size</OptimizationPreference>-->
    <!--<StackTraceSupport>false</StackTraceSupport>-->
  </PropertyGroup>

  <!--
    NativeAOT 发布开关：用 -p:StarAgentAot=true 打开，避免把 PublishAot 作为全局属性传给所有被引用工程
    （多目标库的 net45/net40 目标不支持 AOT，全局传递会直接报 NETSDK1207）。
    仅在 net10.0 目标上生效。
  -->
  <PropertyGroup Condition="'$(StarAgentAot)' == 'true' and '$(TargetFramework)' == 'net10.0'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!--
    Linux 上默认不装载 ICU：
    1，省内存——ICU 三个共享库加内部缓存约占 8MB 常驻；
    2，能起得来——部分嵌入式发行版根本没装 ICU，.NET 默认会在缺少 ICU 时直接启动失败。
    代理用不到区域性数据：界面文案来自自己的词表，语言靠配置/请求头/环境变量判定，
    日志回落英文（要中文日志的部署用环境变量 DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=0 覆盖，
    环境变量优先级高于 runtimeconfig）。Windows 不关，桌面与服务器场景保留完整区域性。
  -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and !$(RuntimeIdentifier.StartsWith('win'))">
    <RuntimeHostConfigurationOption Include="System.Globalization.Invariant" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Stardust\Managers\FirewallManager.cs" Link="Managers\FirewallManager.cs" />
    <Compile Include="..\Stardust\Managers\ServiceController.cs" Link="Managers\ServiceController.cs" />
    <Compile Include="..\Stardust\Managers\ServiceManager.cs" Link="Managers\ServiceManager.cs" />
  </ItemGroup>

  <!--
    小内存设备的运行时开关。用 RuntimeHostConfigurationOption 而不是 runtimeconfig.template.json：
    NativeAOT 发布不支持模板文件（ILC 会告警并忽略），写成项目项则 JIT 与 AOT 两种发布都生效。
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HeapCount" Value="1" />
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="209715200" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation" Value="false" />
    <RuntimeHostConfigurationOption Include="System.Runtime.EnableWriteXorExecute" Value="false" />
  </ItemGroup>
  
  <ItemGroup>
    <EmbeddedResource Include="WebPanel\wwwroot\**" />
  </ItemGroup>

  <!-- 本地联调：与 Stardust 的 UseLocalNewLifeSource 保持同一开关，见 Stardust.csproj 说明 -->
  <PropertyGroup>
    <NewLifeSourceRoot Condition="'$(NewLifeSourceRoot)' == ''">$(MSBuildProjectDirectory)\..\..</NewLifeSourceRoot>
  </PropertyGroup>
  <!-- 本地源码模式下启用上游最新 API（尚未发布的静态命令注册等） -->
  <PropertyGroup Condition="'$(UseLocalNewLifeSource)' == 'true'">
    <DefineConstants>$(DefineConstants);LOCAL_NEWLIFE_SOURCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalNewLifeSource)' == 'true'">
    <ProjectReference Include="$(NewLifeSourceRoot)\NewLife.Agent\NewLife.Agent\NewLife.Agent.csproj" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained" />
    <!-- 本项目的配置类依赖 Core 源生成器生成成员访问器 -->
    <ProjectReference Include="$(NewLifeSourceRoot)\NewLife.Core\NewLife.Core.SourceGenerator\NewLife.Core.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=netstandard2.0" Private="false" AdditionalProperties="PublishAot=false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained;RuntimeIdentifier;RuntimeIdentifiers" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalNewLifeSource)' != 'true'">
    <PackageReference Include="NewLife.Agent" Version="10.18.2026.1107-beta1336" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stardust\Stardust.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Locales 目录由 NewLife.Core 源生成器编译期解析；本项目未直接引用 Core 包，显式挂载输入 -->
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/Locales/*.yml" />
  </ItemGroup>
</Project>
