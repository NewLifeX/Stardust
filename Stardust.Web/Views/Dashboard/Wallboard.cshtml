@model WallboardModel
@using NewLife
@using Stardust.Web.Models.Dashboard
@{
    Layout = "~/Views/Shared/_Layout_Wallboard.cshtml";
    var scope = Model.Scope;
    var nodesOk = Model.NodeOnlineRate >= 95;
    var errorOk = Model.ErrorRate < 0.5;
    Func<Int32, Int32, Double> Rate = (part, all) => all <= 0 ? 0 : Math.Round(Math.Min(part * 100d / all, 100), 1);
}
<div class="wb">
    <header class="wb-head">
        <div class="wb-brand"><i>✦</i>星尘 Stardust</div>
        <div class="wb-title-wrap">
            <h1 class="wb-title">全局运行态势</h1>
            <div class="wb-sub" id="wbViewName">STARDUST · 总览视角 · GLOBAL OVERVIEW</div>
        </div>
        <div class="wb-meta">
            <span style="display:inline-flex;align-items:center;gap:10px">
                <b data-clock>00:00:00</b>
                <span data-theme-switch></span>
            </span>
            <span>@scope.Badge · 数据每 30 秒刷新 · <a href="/Dashboard/System" style="color:inherit;text-decoration:underline">返回看板</a></span>
            <button type="button" class="wb-settings-btn" data-action="wallboard-settings">视角设置</button>
        </div>
    </header>

    <main class="wb-body">
        <div class="wb-col">
            <section class="wb-card">
                <div class="wb-card__head">
                    <h2 class="wb-card__title">节点在线率</h2>
                    <a class="wb-link" href="@DashboardLinks.NodeOnline()">详情</a>
                    <span class="wb-pill @(nodesOk ? "wb-pill--ok" : "wb-pill--warn")"><span class="wb-dot"></span>@(nodesOk ? "健康" : "关注")</span>
                </div>
                <div class="wb-num @(nodesOk ? "wb-num--ok" : "wb-num--warn")">@Model.NodeOnlineRate.ToString("n1")<span class="wb-unit">%</span></div>
                <div class="wb-foot-row"><span>@Model.NodesOnline / @Model.NodesTotal 节点在线</span><span>目标 ≥ 95%</span></div>
                <div class="wb-spark" data-wb-spark="nodeRate" data-spark-color="var(--sd-color-online)"></div>
                <div class="wb-meters">
                    <div class="meter-row" style="grid-template-columns:40px 1fr 44px"><span>在线</span><div class="meter meter--ok"><i style="width:@Rate(Model.NodesOnline, Model.NodesTotal)%"></i></div><b>@Model.NodesOnline</b></div>
                    <div class="meter-row" style="grid-template-columns:40px 1fr 44px"><span>告警</span><div class="meter meter--warn"><i style="width:@Rate(Model.NodesWarn, Model.NodesTotal)%"></i></div><b>@Model.NodesWarn</b></div>
                    <div class="meter-row" style="grid-template-columns:40px 1fr 44px"><span>离线</span><div class="meter meter--bad"><i style="width:@Rate(Model.NodesOffline, Model.NodesTotal)%"></i></div><b>@Model.NodesOffline</b></div>
                </div>
            </section>

            <section class="wb-card">
                <div class="wb-card__head">
                    <h2 class="wb-card__title">今日请求量</h2>
                    <a class="wb-link" href="@DashboardLinks.AppMinuteStat()">详情</a>
                    <span class="wb-card__hint">实时 @Model.CurrentQps.ToString("n0") QPS</span>
                </div>
                <div class="wb-num">@DashboardMath.Abbreviate(Model.TodayRequests)</div>
                <div class="wb-foot-row"><span>峰值 @Model.PeakQps.ToString("n0") QPS</span><span>谷值 @Model.ValleyQps.ToString("n0") QPS</span></div>
                <div class="wb-spark" data-wb-spark="requests" data-spark-color="var(--sd-color-brand)"></div>
            </section>

            <section class="wb-card">
                <div class="wb-card__head">
                    <h2 class="wb-card__title">错误率</h2>
                    <a class="wb-link" href="@DashboardLinks.AlarmList(true)">详情</a>
                    <span class="wb-pill @(Model.Alarms > 0 ? "wb-pill--warn" : "wb-pill--ok")"><span class="wb-dot"></span>@Model.Alarms 条告警</span>
                </div>
                <div class="wb-num @(errorOk ? "wb-num--ok" : "wb-num--warn")">@Model.ErrorRate.ToString("n2")<span class="wb-unit">%</span></div>
                <div class="wb-foot-row"><span>较昨日 @(Model.ErrorRateDelta >= 0 ? "▲" : "▼") @Math.Abs(Model.ErrorRateDelta).ToString("n2")%</span><span>阈值 0.50%</span></div>
                <div class="wb-spark" data-wb-spark="error" data-spark-color="var(--sd-color-offline)"></div>
            </section>
        </div>

        <div class="wb-center">
            <section class="wb-card">
                <div class="wb-card__head">
                    <h2 class="wb-card__title" id="wbHeroTitle">全局吞吐与质量</h2>
                    <a class="wb-link" href="@DashboardLinks.AppMinuteStat()">详情</a>
                    <div class="wb-legend" id="wbHeroLegend">
                        <span><i style="background:var(--sd-color-brand)"></i>请求量 QPS</span>
                        <span><i style="background:var(--sd-color-alert)"></i>错误率 %</span>
                    </div>
                </div>

                <div class="wb-hero-body">
                    <div class="wb-pane is-active" data-pane="0">
                        <div class="wb-stats">
                            <div class="wb-stat"><span>实时 QPS</span><b>@Model.CurrentQps.ToString("n0")<em>QPS</em></b></div>
                            <div class="wb-stat"><span>平均耗时</span><b>@Model.AvgCost<em>ms</em></b></div>
                            <div class="wb-stat"><span>在线应用</span><b>@Model.AppsOnline<em>/ @Model.AppsTotal</em></b></div>
                        </div>
                        <div id="wbTrend" class="wb-chart"></div>
                    </div>

                    <div class="wb-pane" data-pane="1">
                        <div class="wb-stats">
                            <div class="wb-stat"><span>项目总数</span><b>@Model.Projects.Count<em>个</em></b></div>
                            <div class="wb-stat"><span>异常项目</span><b>@Model.Projects.Count(e => e.Alarms > 0 || e.Health < 90)<em>个</em></b></div>
                            <div class="wb-stat"><span>今日部署</span><b>@Model.TodayDeploys<em>次</em></b></div>
                        </div>
                        <div id="wbProjects" class="wb-chart"></div>
                    </div>

                    <div class="wb-pane" data-pane="2">
                        <div class="wb-stats">
                            <div class="wb-stat"><span>节点总数</span><b>@Model.NodesTotal<em>台</em></b></div>
                            <div class="wb-stat"><span>平均 CPU</span><b>@(Model.Regions.Count > 0 ? Model.Regions.Average(e => e.Cpu).ToString("n0") : "0")<em>%</em></b></div>
                            <div class="wb-stat"><span>平均内存</span><b>@(Model.Regions.Count > 0 ? Model.Regions.Average(e => e.Memory).ToString("n0") : "0")<em>%</em></b></div>
                        </div>
                        <div id="wbNodes" class="wb-chart"></div>
                    </div>

                    <div class="wb-pane" data-pane="3">
                        <div class="wb-stats">
                            <div class="wb-stat"><span>活跃告警</span><b>@Model.AlarmAlarming<em>条</em></b></div>
                            <div class="wb-stat"><span>已恢复</span><b>@Model.AlarmRecovered<em>条</em></b></div>
                            <div class="wb-stat"><span>今日触发</span><b>@Model.AlarmToday<em>次</em></b></div>
                        </div>
                        <div id="wbAlerts" class="wb-chart"></div>
                    </div>
                </div>
            </section>

            <section class="wb-card">
                <div class="wb-card__head">
                    <h2 class="wb-card__title">项目健康</h2>
                    <a class="wb-link" href="@DashboardLinks.Projects()">详情</a>
                    <span class="wb-card__hint">@scope.Badge</span>
                </div>
                <div class="wb-list wb-list--fixed">
                    @foreach (var item in Model.Projects.Take(6))
                    {
                        var tone = DashboardMath.HealthTone(item.Health);
                        var pillClass = tone == "ok" ? "wb-pill--ok" : tone == "warn" ? "wb-pill--warn" : "wb-pill--bad";
                        <a class="wb-row" href="@item.Url" style="text-decoration:none;color:inherit">
                            <span class="wb-pill @pillClass">@item.Name</span>
                            <div class="meter meter--@tone" style="height:8px"><i style="width:@(item.Health)%"></i></div>
                            <span>@item.Apps 应用 · @item.NodesOnline/@item.Nodes 节点 · @item.ErrorRate.ToString("n2")%</span>
                        </a>
                    }
                    @if (Model.Projects.Count == 0)
                    {
                        <div class="empty" style="padding:16px;"><div class="empty__title">暂无项目数据</div></div>
                    }
                </div>
            </section>
        </div>

        <div class="wb-col">
            <section class="wb-card">
                <div class="wb-card__head">
                    <h2 class="wb-card__title">实时事件</h2>
                    <a class="wb-link" href="@DashboardLinks.AlarmList()">详情</a>
                    <span class="wb-pill wb-pill--bad"><span class="wb-dot"></span>LIVE</span>
                </div>
                <div id="wbEvents" class="wb-list" style="gap:0">
                    @foreach (var item in Model.Events.Take(6))
                    {
                        <a class="wb-row" href="@item.Url" style="grid-template-columns:1fr auto;text-decoration:none;color:inherit">
                            <span class="muted" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@item.Title</span>
                            <span>@item.TimeText</span>
                        </a>
                    }
                    @if (Model.Events.Count == 0)
                    {
                        <div class="empty" style="padding:16px;"><div class="empty__title">暂无事件</div></div>
                    }
                </div>
            </section>

            <section class="wb-card">
                <div class="wb-card__head">
                    <h2 class="wb-card__title">Top 应用</h2>
                    <a class="wb-link" href="@DashboardLinks.Apps()">详情</a>
                    <span class="wb-card__hint">按 QPS</span>
                </div>
                <div id="wbTopApps" class="wb-chart"></div>
            </section>

            <section class="wb-card">
                <div class="wb-card__head">
                    <h2 class="wb-card__title">资源水位</h2>
                    <a class="wb-link" href="@DashboardLinks.NodeList()">详情</a>
                    <span class="wb-card__hint">按@(Model.RegionDimension)</span>
                </div>
                <div class="wb-list wb-list--fixed">
                    @foreach (var row in Model.Regions.Take(4))
                    {
                        <a class="wb-row" href="@row.Url" style="text-decoration:none;color:inherit">
                            <span class="muted">@row.Name · @row.Nodes</span>
                            <div class="meter meter--@DashboardMath.Level(row.Cpu)"><i style="width:@(Math.Min(row.Cpu, 100))%"></i></div>
                            <span>CPU @row.Cpu.ToString("n0")%</span>
                        </a>
                    }
                    @if (Model.Regions.Count == 0)
                    {
                        <div class="empty" style="padding:16px;"><div class="empty__title">暂无资源数据</div></div>
                    }
                </div>
            </section>
        </div>
    </main>

    <footer class="wb-foot">
        <div class="wb-dots" id="wbDots">
            <button type="button" class="is-active" data-view="0" aria-label="总览视角"></button>
            <button type="button" data-view="1" aria-label="项目视角"></button>
            <button type="button" data-view="2" aria-label="节点视角"></button>
            <button type="button" data-view="3" aria-label="告警视角"></button>
        </div>
        <span class="wb-hint" id="wbHint">每 12 秒自动轮播 · 按空格暂停 · 点击指示条切换视角</span>
        <span>数据来源 Nodes/Node · Registry/App · Monitors/AppMinuteStat · 最后更新 <b data-clock>--:--:--</b></span>
    </footer>
</div>

@section Scripts {
    <script>
        window.__SD_DATA__ = @Html.Raw(Json.Serialize(Model));
    </script>
    <script src="~/dashboard/pages/wallboard.js"></script>
}
