@model PickerPageModel
@using Stardust.Web.Models.Dashboard
@{
    Layout = "~/Views/Shared/_Layout_Dashboard.cshtml";
    var scope = Model.Scope;
}
<div class="scope-notice">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M12 3l9 4v6c0 4.6-3.4 7.4-9 8-5.6-.6-9-3.4-9-8V7z" /><path d="M12 9v4M12 16h.01" />
    </svg>
    <span class="notice--limited">当前为受限数据视角：仅显示你被授权的项目。</span>
    <span class="notice--none">当前账号未授权任何项目。</span>
</div>

<section class="scope-empty">
    <div class="scope-empty__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /><path d="M12 14v3" />
        </svg>
    </div>
    <h2>暂无授权项目</h2>
    <p>你的账号还没有被加入任何项目。请联系项目管理员在「项目成员」中授权，或前往平台申请加入项目。</p>
    <a class="btn btn--primary" href="/Platform/ProjectUser">去申请项目权限</a>
</section>

<section class="scope-bar">
    <div>
        <div class="crumbs"><a href="/Dashboard/System">看板总览</a><span class="sep">/</span><span>项目</span></div>
        <h1 class="page-title">@Model.Title</h1>
        <p class="page-sub">@Model.Subtitle · 共 <strong>@Model.Projects.Count</strong> 个可见项目</p>
    </div>
    <div class="toolbar">
        <a class="btn" href="/Platform/GalaxyProject">项目管理</a>
        <a class="btn btn--primary" href="/Dashboard/System">返回系统看板</a>
    </div>
</section>

<section class="sd-grid">
    @foreach (var item in Model.Projects)
    {
        var healthTone = DashboardMath.HealthTone(item.Health);
        <a class="sd-card col-12" href="@item.Url" style="text-decoration:none;color:inherit;">
            <div class="sd-card__head">
                <h2 class="sd-card__title">@item.Name</h2>
                <span class="pill pill--@healthTone">@DashboardMath.HealthLevel(item.Health) @item.Health</span>
            </div>
            <div class="app-card__stats" style="margin-bottom:10px;">
                <div class="app-card__stat"><span>应用</span><b>@item.AppsOnline/@item.Apps</b></div>
                <div class="app-card__stat"><span>节点</span><b>@item.NodesOnline/@item.Nodes</b></div>
                <div class="app-card__stat"><span>错误率</span><b>@item.ErrorRate.ToString("n2")%</b></div>
            </div>
            <div class="meter @(item.Health >= 95 ? "meter--ok" : item.Health >= 90 ? "meter--warn" : "meter--bad")"><i style="width:@(item.Health)%"></i></div>
            <div class="app-card__foot" style="margin-top:10px;">
                <span>活跃告警 @item.Alarms 条</span>
                <span>进入看板 →</span>
            </div>
        </a>
    }
    @if (Model.Projects.Count == 0)
    {
        <div class="sd-card col-24">
            <div class="empty">
                <div class="empty__title">暂无可见项目</div>
                <div class="empty__desc">请先在项目管理中创建项目，并把项目成员授权给相关人员。</div>
                <a class="btn btn--primary" href="/Platform/GalaxyProject">去创建项目</a>
            </div>
        </div>
    }
</section>
