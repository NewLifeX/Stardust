@using NewLife;
@using NewLife.Web;
@using NewLife.Cube;
@using XCode;
@using Stardust.Data.Configs;
@{
    var fact = ViewBag.Factory as IEntityFactory;
    var page = ViewBag.Page as Pager;

    var dic = new Dictionary<Int32, String>();
    dic[1] = L.T("成功");
    dic[0] = L.T("失败");
}
<div class="form-group">
    <label for="action" class="control-label">@L.T("类别：")</label>
    @Html.ForDropDownList("action", ConfigHistory.FindAllActions(), page["action"], L.T("全部"), true)
</div>
<div class="form-group">
    <label for="success" class="control-label">@L.T("状态：")</label>
    @Html.ForDropDownList("success", dic, page["success"], L.T("全部"), true)
</div>
@await Html.PartialAsync("_DateRange")