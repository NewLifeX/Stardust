@using NewLife;
@using NewLife.Web;
@using NewLife.Cube;
@using XCode;
@using Stardust.Data.Nodes;
@{
    var fact = ViewBag.Factory as IEntityFactory;
    var page = ViewBag.Page as Pager;

    var dic = new Dictionary<Int32, String>();
    dic.Add(1, L.T("成功"));
    dic.Add(0, L.T("失败"));
}
<div class="form-group">
    <label for="action" class="control-label">@L.T("操作：")</label>
    @Html.ForDropDownList("action", NodeHistory.FindAllAction(), page["action"], L.T("全部"), true)
</div>
<div class="form-group">
    <label for="success" class="control-label">@L.T("状态：")</label>
    @Html.ForDropDownList("success", dic, page["success"], L.T("全部"), true)
</div>
@await Html.PartialAsync("_SelectNode", new Stardust.Web.Models.SelectNodeModel { Id = "nodeId" })
@await Html.PartialAsync("_DateRange")