@*
    Node 列表操作列重载
    - WakeUp: 离线节点无法接收平台指令，由同局域网在线节点代发 Wake-on-LAN 魔术包
    - CRUD: 查看/编辑/删除/恢复（同默认实现）
*@
@using NewLife;
@using NewLife.Cube
@using XCode;
@using XCode.Membership;
@using Stardust.Data.Nodes;
@{
    var entity = Model as IEntity;
    var set = ViewBag.PageSetting as PageSetting ?? PageSetting.Global;
    var rv = entity.GetRouteKey();
}

@* 唤醒：目标机器离线时只能由同网段在线节点广播魔术包 *@
@if (entity is Node node && !node.MACs.IsNullOrEmpty() && this.Has(PermissionFlags.Update))
{
    <a href="@Url.Action("WakeUp", new { id = node.ID })" data-action="action" data-confirm="@L.T("确认唤醒该节点？需要同网段在线节点代发，目标机器需开启 WOL。")" title="@L.T("节点离线时，由同局域网在线节点广播唤醒魔术包")" style="margin-left:5px;">@L.T("唤醒")</a>
}

@* CRUD 操作 *@
@if (set.IsReadOnly)
{
    if (this.Has(PermissionFlags.Detail))
    {
        <i class="glyphicon glyphicon-edit" style="color: blue;"></i>
        <a href="@Url.Action("Detail", rv)" class="editcell" title="@L.T("双击本行任意地方也可以进入查看页")">@L.T("查看")</a>
    }
}
else if (this.Has(PermissionFlags.Update))
{
    <i class="glyphicon glyphicon-edit" style="color: blue;"></i>
    <a href="@Url.Action("Edit", rv)" class="editcell" title="@L.T("双击本行任意地方也可以进入编辑表单页")">@L.T("编辑")</a>
}
else if (this.Has(PermissionFlags.Detail))
{
    <i class="glyphicon glyphicon-edit" style="color: blue;"></i>
    <a href="@Url.Action("Detail", rv)" class="editcell" title="@L.T("双击本行任意地方也可以进入查看页")">@L.T("查看")</a>
}
@if (this.Has(PermissionFlags.Delete))
{
    var fact = ViewBag.Factory as IEntityFactory;
    var fi = (fact == null || fact.Fields == null) ? null : fact.Fields.FirstOrDefault(e => e.Name.EqualIgnoreCase("Deleted", "IsDelete", "IsDeleted"));
    if (fi != null && fi.Type == typeof(Boolean) && (Boolean)entity[fi.Name])
    {
        rv["restore"] = 1;
        <i class="glyphicon glyphicon-transfer" style="color: green;"></i>
        <a href="@Url.Action("Delete", rv)" data-action="action" data-confirm="@L.T("确认恢复？")">@L.T("恢复")</a>
    }
    else
    {
        <i class="glyphicon glyphicon-remove" style="color: red;"></i>
        <a href="@Url.Action("Delete", rv)" data-action="action" data-confirm="@L.T("确认删除？")">@L.T("删除")</a>
    }
}
