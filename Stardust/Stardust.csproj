<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net45;net461;netstandard2.0;netstandard2.1;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>Stardust</AssemblyName>
    <AssemblyTitle>Stardust distributed core</AssemblyTitle>
    <Description>Stardust distributed core client library. One-line integration for configuration delivery, service registration and discovery, distributed tracing, APM and log reporting.</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 NewLife</Copyright>
    <VersionPrefix>3.10</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</AssemblyVersion>
    <OutputPath>..\Bin</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
    <NoWarn>1701;1702;NU5104;NU1505;NETSDK1138;CS7035;CS8600;CS8602;CS8603;CS8604;CS8618;CS8619;CS8625</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>
    <WarningsAsErrors>CA2007</WarningsAsErrors>
    <PackageDescription>星尘分布式核心客户端库。一行代码接入，提供配置下发、服务注册与发现、全链路追踪、APM 性能监控与日志上报。
Stardust distributed core client library. One-line integration for configuration delivery, service registration and discovery, distributed tracing, APM and log reporting.</PackageDescription>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>NewLife.$(AssemblyName)</PackageId>
    <Authors>$(Company)</Authors>
    <PackageProjectUrl>https://newlifex.com/blood/stardust</PackageProjectUrl>
    <PackageIcon>leaf.png</PackageIcon>
    <RepositoryUrl>https://github.com/NewLifeX/Stardust</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>新生命团队;X组件;NewLife;$(AssemblyName)</PackageTags>
    <PackageReleaseNotes>跟随 NewLife.Core v12 完成 31 种语言本地化与请求级语言协商；安全扫描 V-1~V-17 加固（密钥、令牌、限流、CORS、越权封堵）；新增 Android/iOS 移动端代理与 Rust/C++/Go 原生代理；接入 OpenTelemetry 埋点并降低监控统计写放大；新增 WebApi 纯 API 后端与 75 例集成测试、Playwright 端到端巡检；修复 Linux 上 OS 类型误判与跨用户进程句柄采集异常；升级 NewLife 依赖至 2026.10.24 正式版</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Managers\ServiceController.cs" />
    <Compile Remove="Managers\ServiceManager.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="res\md5.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="res\md5.txt" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- 本地联调：NewLife 源码仓库与本仓库同处一个根目录（默认 C:\X）时，
       加 -p:UseLocalNewLifeSource=true 改为项目引用，便于 AOT 适配期间同步修改上游；
       默认仍引用 NuGet 包，保持正常构建与发布不受影响 -->
  <PropertyGroup>
    <NewLifeSourceRoot Condition="'$(NewLifeSourceRoot)' == ''">$(MSBuildProjectDirectory)\..\..</NewLifeSourceRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalNewLifeSource)' == 'true'">
    <ProjectReference Include="$(NewLifeSourceRoot)\NewLife.Core\NewLife.Core\NewLife.Core.csproj" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained" />
    <ProjectReference Include="$(NewLifeSourceRoot)\NewLife.Remoting\NewLife.Remoting\NewLife.Remoting.csproj" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained" />
    <!-- 项目引用不会像 NuGet 包那样把 analyzers 传递下来，本地联调显式挂上 Core/Remoting 源生成器 -->
    <ProjectReference Include="$(NewLifeSourceRoot)\NewLife.Core\NewLife.Core.SourceGenerator\NewLife.Core.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=netstandard2.0" Private="false" AdditionalProperties="PublishAot=false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained;RuntimeIdentifier;RuntimeIdentifiers" />
    <ProjectReference Include="$(NewLifeSourceRoot)\NewLife.Remoting\NewLife.Remoting.SourceGenerator\NewLife.Remoting.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=netstandard2.0" Private="false" AdditionalProperties="PublishAot=false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained;RuntimeIdentifier;RuntimeIdentifiers" />
    <!-- Core 包的 props 会把 Locales\*.yml 挂成 AdditionalFiles，项目引用模式需自行挂载 -->
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/Locales/*.yml" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalNewLifeSource)' != 'true'">
    <PackageReference Include="NewLife.Remoting" Version="4.0.2026.1024" />
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1024" />
  </ItemGroup>

</Project>
