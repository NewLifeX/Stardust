<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1</TargetFrameworks>
    <AssemblyTitle>Stardust Data</AssemblyTitle>
    <Description>Data layer of the Stardust distributed service framework. Defines entity models and statistics jobs based on XCode ORM, supporting persistence and computation for node management, application management, configuration center, registry, monitoring center, and release center, compatible with multiple databases.</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 NewLife</Copyright>
    <VersionPrefix>2.0</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <!--<OutputPath>..\Bin</OutputPath>-->
    <!--<DocumentationFile>$(OutputPath)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>-->
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <LangVersion>latest</LangVersion>
    <IsPackable>False</IsPackable>
    <NoWarn>1701;1702;NU5104;NETSDK1138;CS7035</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Config\**" />
    <Compile Remove="RedisNodes\Config\**" />
    <EmbeddedResource Remove="Config\**" />
    <EmbeddedResource Remove="RedisNodes\Config\**" />
    <None Remove="Config\**" />
    <None Remove="RedisNodes\Config\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Configs\配置在线.Biz.cs" />
    <Compile Remove="Configs\配置在线.cs" />
    <Compile Remove="Deployment\部署在线.Biz.cs" />
    <Compile Remove="Deployment\部署在线.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalNewLifeSource)' != 'true'">
    <!-- 待 NewLife.XCode 发布包含 ConfigSync 的版本后升级此版本号；在此之前本地联调用 -p:UseLocalNewLifeSource=true -->
    <PackageReference Include="NewLife.XCode" Version="12.3.2026.1115-beta0353" />
  </ItemGroup>

  <!-- 本地联调：NewLife 源码仓库与本仓库同处一个根目录（默认 C:\X）时，
       加 -p:UseLocalNewLifeSource=true 改为项目引用，便于同步上游未发布的配置同步引擎 -->
  <PropertyGroup>
    <NewLifeSourceRoot Condition="'$(NewLifeSourceRoot)' == ''">$(MSBuildProjectDirectory)\..\..</NewLifeSourceRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalNewLifeSource)' == 'true'">
    <ProjectReference Include="$(NewLifeSourceRoot)\NewLife.XCode\XCode\XCode.csproj" />
    <!-- 项目引用不会像 NuGet 包那样把 analyzers 传递下来，本地联调显式挂上 Core 源生成器 -->
    <ProjectReference Include="$(NewLifeSourceRoot)\NewLife.Core\NewLife.Core.SourceGenerator\NewLife.Core.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=netstandard2.0" Private="false" AdditionalProperties="PublishAot=false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained;RuntimeIdentifier;RuntimeIdentifiers" />
    <CompilerVisibleProperty Include="NewLifeLocalizationGenerateL" />
    <CompilerVisibleProperty Include="NewLifeLocalizationOverwrite" />
    <CompilerVisibleProperty Include="NewLifeLocalizationLanguages" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stardust\Stardust.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Locales 目录由 NewLife.Core 源生成器编译期解析；本项目未直接引用 Core 包，显式挂载输入 -->
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\Locales\*.yml" />
  </ItemGroup>
</Project>
