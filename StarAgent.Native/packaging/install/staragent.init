#!/bin/sh /etc/rc.common
# OpenWrt procd 启动脚本模板。原生 Agent 自身不做守护，由 procd 负责 respawn。
START=95
STOP=10
USE_PROCD=1

PROG=/opt/staragent/staragent
CONFIG=/etc/staragent/staragent.json

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" run --config "$CONFIG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# procd 会向进程发送 SIGTERM，Agent 收到后 1 秒内退出
	:
}
